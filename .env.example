# Skapa en Personal Access Token på https://airtable.com/create/tokens
# med scopes: data.records:read (och data.records:write om ni senare vill skriva tillbaka)
# samt access till er DUL-bas.
AIRTABLE_PAT=

# Bas-ID hittar du i Airtables API-dokumentation för basen (börjar på "app...")
AIRTABLE_BASE_ID=

# Namnet på den tabell som ska visas i dashboarden, t.ex. "Coachees" eller "Sessioner"
AIRTABLE_TABLE_NAME=
